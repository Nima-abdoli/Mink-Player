<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.0</TargetFramework>
    <RootNamespace>Mink_Player_Core</RootNamespace>
    <UseWPF>true</UseWPF>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Xmasta.pfx</AssemblyOriginatorKeyFile>
    <PackageId>Mink Player</PackageId>
    <Authors>Xmasta inc</Authors>
    <Product>Mink Player</Product>
    <Company>Xmasta inc</Company>
    <Description>Simple Music Player that work in background</Description>
    <AssemblyName>Mink Player</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Icon\Tray\mTray-Pause.ico" />
    <None Remove="Resources\Icon\Tray\mTray-Play.ico" />
    <None Remove="Resources\Icon\Tray\mTray_Empthy.ico" />
    <None Remove="Resources\Icon\Tray\mTray_Pause.png" />
    <None Remove="Resources\Icon\Tray\mTray_Play.png" />
    <None Remove="Resources\Icon\Tray\Tray Empty.ico" />
    <None Remove="Resources\Icon\Tray\Tray Puase.ico" />
    <None Remove="Resources\Image\Cover\Cassette.png" />
    <None Remove="Resources\Image\Cover\Mink Cover.png" />
    <None Remove="Resources\Tray Play.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="4.6.0" />
    <PackageReference Include="TagLibSharp" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2\System.Windows.Forms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icon\Tray\mTray-Pause.ico" />
    <Resource Include="Resources\Icon\Tray\mTray-Play.ico" />
    <Resource Include="Resources\Icon\Tray\mTray_Empthy.ico" />
    <Resource Include="Resources\Icon\Tray\Tray Empty.ico" />
    <Resource Include="Resources\Icon\Tray\Tray Play.ico" />
    <Resource Include="Resources\Icon\Tray\Tray Puase.ico" />
    <Resource Include="Resources\Image\Cover\Cassette.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Image\Cover\Mink Cover.png" />
  </ItemGroup>

</Project>