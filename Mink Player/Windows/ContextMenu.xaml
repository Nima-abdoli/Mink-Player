<Window x:Class="Mink_Player.Windows.ContextMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mink_Player.Windows"
        mc:Ignorable="d"
        Title="ContextMenu"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Height="270" Width="230" 
        Background="{x:Null}" 
        ShowInTaskbar="False" 
        Deactivated="Window_Deactivated" 
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <Storyboard x:Key="SlideUp">
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="MainGrid">
                <EasingThicknessKeyFrame KeyTime="0" Value="0,270,0,-272"/>
                <EasingThicknessKeyFrame KeyTime="0:0:0.25" Value="0"/>
            </ThicknessAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    
    <!--<Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideUp}"/>
        </EventTrigger>
    </Window.Triggers>-->

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
        <!--#region Background Mask and Border -->
        
        <!-- Mask Border -->
        <Border x:Name="BackMask" Grid.Row="1" CornerRadius="10" Background="#FF646464"/>

        <!-- Background Border -->
        <Border Grid.Row="1" CornerRadius="10" >
            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=BackMask}"/>
            </Border.OpacityMask>

            <Grid>

                <Image x:Name="BackRound_Image" Stretch="UniformToFill" Source="/Mink Player;component/Resources/Images/Cover/Cassette.png" 
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="50" />
                    </Image.Effect>
                </Image>

                <Rectangle Fill="#66303030" />

            </Grid>

        </Border>
        <!--#endregion-->

        <!--#region Menu Grid -->
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="SettingBtn" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                        Width="30" Height="30" Margin="20 10 0 0" Grid.Row="0" ToolTip="Open Setting"
                        HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{x:Null}"/>

            <Button x:Name="MuteBtn" Content="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                        Width="30" Height="30" Margin="0 10 20 0" Grid.Row="0" ToolTip="Mute/Unmute Sound"
                        HorizontalAlignment="Right" Background="{x:Null}" BorderBrush="{x:Null}"/>

            <TextBlock Text="Music Title"  Grid.Row="1" HorizontalAlignment="Center" Margin="0 15 0 0" 
                       FontSize="18"/>

            <TextBlock Text="Artsit" Grid.Row="2" HorizontalAlignment="Center" Margin=" 0 5 0 0"
                       FontSize="16" />

            <!-- Slider Grid -->
            <Grid Grid.Row="3" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="00:00" HorizontalAlignment="Left" FontSize="11" Margin="10 0 0 0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="00:00" HorizontalAlignment="Right" FontSize="11" Margin="0 0 10 0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                <Slider Grid.Row="1" Margin="10 4" />

            </Grid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 0">
                
                <Button Grid.Column="0" Width="25" Height="25" 
                        Background="{x:Null}" BorderBrush="{x:Null}" ToolTip="Previous Music" Margin="10 0 10 0"
                        FontSize="20" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" />

                <Button Grid.Column="1" Width="25" Height="25" 
                        Background="{x:Null}" BorderBrush="{x:Null}" ToolTip="Play/Pause Music" Margin="10 0 10 0"
                        FontSize="20" Content="&#xE769;" FontFamily="Segoe MDL2 Assets" />

                <Button Grid.Column="2" Width="25" Height="25" 
                        Background="{x:Null}" BorderBrush="{x:Null}" ToolTip="Next Music" Margin="10 0 10 0"
                        FontSize="20" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" />

            </StackPanel>

            <Grid Grid.Row="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="25" Height="25" 
                        Background="{x:Null}" BorderBrush="{x:Null}" ToolTip="Select Music from File"
                        FontSize="20" Content="&#xE762;" FontFamily="Segoe MDL2 Assets" />

                <Button Grid.Column="1" Width="25" Height="25" 
                        Background="{x:Null}" BorderBrush="{x:Null}" ToolTip="Open DashBoard"
                        FontSize="20" Content="&#xF246;" FontFamily="Segoe MDL2 Assets" />

                <Button Grid.Column="2" Width="25" Height="25" 
                        Background="{x:Null}" BorderBrush="{x:Null}" ToolTip="Close Mink Player"
                        FontSize="20" Content="&#xE7E8;" FontFamily="Segoe MDL2 Assets" />

            </Grid>

        </Grid>
        <!--#endregion-->

        

        <!-- Cover Image -->
        <Border Width="100" Height="100" CornerRadius="10" Grid.RowSpan="2" VerticalAlignment="Top" >
            <Border.Background>
                <ImageBrush ImageSource="/Mink Player;component/Resources/Images/Cover/Cassette.png"
                            RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
            </Border.Background>
        </Border>

    </Grid>

    
    
    
</Window>
