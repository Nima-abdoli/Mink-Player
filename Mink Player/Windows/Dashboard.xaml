<Window x:Class="Mink_Player.Windows.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mink_Player.Windows"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="{x:Null}"
        WindowStartupLocation="CenterScreen"
        Title="Mink Player" 
        ResizeMode="CanMinimize"
        Height="450" Width="650">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- window resources -->
    <Window.Resources>
        <ResourceDictionary>

            <!-- style to work with -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/CircleButtonStyle.xaml"/>
                <ResourceDictionary Source="/Style/XSlider.xaml"/>
                <ResourceDictionary Source="/Style/Fonts.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <!-- Mask Border -->
        <Border x:Name="BackMask" CornerRadius="10" Background="#FF646464"/>

        <!-- border shape -->
        <Border CornerRadius="15" >
            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=BackMask}"/>
            </Border.OpacityMask>

            <!-- Main grid -->
            <Grid RenderOptions.BitmapScalingMode="HighQuality" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TitleBar -->
                <Grid x:Name="Title_Grid" Grid.Row="0" Background="#7F323232" MouseDown="Title_Grid_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="25" Source="/Mink Player;component/Resources/Images/Mink Cover.png" 
                           Margin="5 1 0 1" Grid.Column="0"/>

                    <!-- Windows control -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" >

                        <Button x:Name="Minimize_Btn" Click="Minimize_Btn_Click"
                                Background="{x:Null}" BorderBrush="{x:Null}"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE921;" Foreground="White"
                                Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>


                        <Button x:Name="CloseWindow_btn" Click="CloseWindow_btn_Click"
                                Background="{x:Null}" BorderBrush="{x:Null}"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" Foreground="White"
                                Height="30" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>


                    </StackPanel>

                </Grid>

                <!-- line in middle -->
                <Separator Grid.Row="1" Foreground="White"  RenderTransformOrigin="0.5,0.5" 
                               Width="360"  >
                    <Separator.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Separator.RenderTransform>
                </Separator>

                <!-- Dashboard page -->
                <Grid x:Name="DashBoard_Grid" Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Music control Grid -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="210"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Button Content="&#xE712;"  Style="{StaticResource CircleButton}"
                                Width="30" Height="30" Margin="5 5 5 0"
                                FontFamily="Segoe MDL2 Assets" FontSize="20"
                                HorizontalAlignment="Left" Foreground="White"/>
                        
                        <!-- music info grid -->
                        <Grid Grid.Row="1" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border x:Name="MusicCover" CornerRadius="10" HorizontalAlignment="Center"
                                    Width="130" Height="130" Grid.Row="0" Margin="10 0 10 0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Mink Player;component/Resources/Images/Cover/Cassette.png"/>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="Music Title" Grid.Row="1" Margin="0 5 0 2"
                                       HorizontalAlignment="Center" 
                                       FontFamily="{StaticResource Poiret-one}" FontSize="23" FontWeight="SemiBold" 
                                       Foreground="White"/>

                            <TextBlock Text="Artist" Grid.Row="2" Margin="0 2"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Poiret-one}" FontSize="23" FontWeight="SemiBold" 
                                       Foreground="White"/>
                            
                        </Grid>
                        
                        
                        <!-- music control grid -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Slider Grid -->
                            <Grid Grid.Row="3" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TimePass_TxtBl" Text="00:00" HorizontalAlignment="Left" FontSize="11" Margin="10 0 0 0"
                                           RenderOptions.BitmapScalingMode="HighQuality" Foreground="#FFECECEC" />
                                <TextBlock x:Name="TotalTime_TxtBl" Text="00:00" HorizontalAlignment="Right" FontSize="11" Margin="0 0 10 0"
                                           RenderOptions.BitmapScalingMode="HighQuality" Foreground="#FFECECEC" />

                                <Slider x:Name="Context_Slider" Grid.Row="1" Margin="10 4" IsMoveToPointEnabled="True" 
                                        Maximum="0" Minimum="0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        />

                            </Grid>

                        </Grid>
                        
                    </Grid>

                    <!-- music List View  -->
                    <ListView Grid.Column="2" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White"
                              HorizontalContentAlignment="Center" 
                              FontSize="18" FontFamily="{StaticResource Poiret-one}" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Margin="0 15 0 15" Padding="5" >

                        <ListViewItem Content="Test 1" Padding="5"/>
                        <ListViewItem Content="Test 2" Padding="5"/>
                        <ListViewItem Content="Test 3" Padding="5"/>
                        <ListViewItem Content="Test 4" Padding="5"/>
                        <ListViewItem Content="Test 5" Padding="5"/>
                        <ListViewItem Content="Test 6" Padding="5"/>
                        <ListViewItem Content="Test 7" Padding="5"/>
                        <ListViewItem Content="Test 8" Padding="5"/>
                        <ListViewItem Content="Test 9" Padding="5"/>
                        <ListViewItem Content="Test 10" />
                        <ListViewItem Content="Test 11" />
                        <ListViewItem Content="Test 12" />
                        <ListViewItem Content="Test 13" />
                        <ListViewItem Content="Test 14" />
                        <ListViewItem Content="Test 15" />
                        <ListViewItem Content="Test 16" />
                        <ListViewItem Content="Test 17" />
                        <ListViewItem Content="Test 18" />
                        <ListViewItem Content="Test 19" />
                        <ListViewItem Content="Test 20" />
                        <ListViewItem Content="Test 21" Padding="2"/>
                        <ListViewItem Content="Test 22" Padding="2"/>
                        <ListViewItem Content="Test 23" Padding="2"/>
                        <ListViewItem Content="Test 24" Padding="2"/>
                        <ListViewItem Content="Test 24" Padding="2"/>
                        <ListViewItem Content="Test 25" Padding="2"/>
                        <ListViewItem Content="Test 26" Padding="2"/>
                        <ListViewItem Content="Test 27" Padding="2"/>
                        <ListViewItem Content="Test 28" Padding="2"/>
                        <ListViewItem Content="Test 29" Padding="2"/>
                        <ListViewItem Content="Test 30" Padding="2"/>
                        <ListViewItem Content="Test 1" Padding="2"/>
                        <ListViewItem Content="Test 2" Padding="2"/>
                        <ListViewItem Content="Test 3" Padding="2"/>
                        <ListViewItem Content="Test 4" Padding="2"/>
                        <ListViewItem Content="Test 5" Padding="2"/>
                        <ListViewItem Content="Test 6" Padding="2"/>
                        <ListViewItem Content="Test 7" Padding="2"/>
                        <ListViewItem Content="Test 8" Padding="2"/>
                        <ListViewItem Content="Test 9" Padding="2"/>
                        <ListViewItem Content="Test 10" Padding="2"/>
                        <ListViewItem Content="Test 11" Padding="2"/>
                        <ListViewItem Content="Test 12" Padding="2"/>
                        <ListViewItem Content="Test 13" Padding="2"/>
                        <ListViewItem Content="Test 14" Padding="2"/>
                        <ListViewItem Content="Test 15" Padding="2"/>
                        <ListViewItem Content="Test 16" Padding="2"/>
                        <ListViewItem Content="Test 17" Padding="2"/>
                        <ListViewItem Content="Test 18" Padding="2"/>
                        <ListViewItem Content="Test 19" Padding="2"/>
                        <ListViewItem Content="Test 20" Padding="2"/>
                        <ListViewItem Content="Test 21" Padding="2"/>
                        <ListViewItem Content="Test 22" Padding="2"/>
                        <ListViewItem Content="Test 23" Padding="2"/>
                        <ListViewItem Content="Test 24" Padding="2"/>
                        <ListViewItem Content="Test 24" Padding="2"/>
                        <ListViewItem Content="Test 25" Padding="2"/>
                        <ListViewItem Content="Test 26" Padding="2"/>
                        <ListViewItem Content="Test 27" Padding="2"/>
                        <ListViewItem Content="Test 28" Padding="2"/>
                        <ListViewItem Content="Test 29" Padding="2"/>
                        <ListViewItem Content="Test 30" Padding="2"/>

                    </ListView>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
